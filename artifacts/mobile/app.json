{
  "expo": {
    "name": "OG Exports",
    "slug": "og-exports",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/og-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.ogexports.investor"
    },
    "web": {
      "favicon": "./assets/images/og-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OG Exports uses Face ID to unlock your saved investor account and confirm protected actions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "6a3d65e6-af41-4def-bdae-4d693f31effa"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
