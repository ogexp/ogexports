{
  "expo": {
    "name": "OG Exports",
    "slug": "og-exports-50",
    "owner": "ogexp55",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/og-app-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/images/og-app-icon.png"
    },
    "android": {
      "package": "com.ogexports.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 4,
      "icon": "./assets/images/og-app-icon.png",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/og-adaptive-foreground.png",
        "backgroundImage": "./assets/images/og-icon-background.png",
        "backgroundColor": "#0A3335"
      }
    },
    "web": {
      "favicon": "./assets/images/og-favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "investor-updates-v2"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OG Exports uses Face ID to unlock your saved investor account and confirm protected actions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A3335",
            "image": "./assets/images/splash-transparent.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
      "projectId": "1178e32b-a81d-4a9e-a36e-df5090f3c8ba"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
