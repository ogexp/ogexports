{
  "expo": {
    "name": "OG Exports",
    "slug": "og-exports-50",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/og-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.ogexports.investor"
    },
    "web": {
      "favicon": "./assets/images/og-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OG Exports uses Face ID to unlock your saved investor account and confirm protected actions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2",
          "image": "./assets/images/og-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "1178e32b-a81d-4a9e-a36e-df5090f3c8ba"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
