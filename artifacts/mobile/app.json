{
  "expo": {
    "name": "OG Exports",
    "slug": "og-exports-50",
    "version": "2.1.6",
    "orientation": "portrait",
    "icon": "./assets/images/og-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.ogexports.invest",
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/images/og-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OG Exports uses Face ID to unlock your saved investor account and confirm protected actions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F3",
          "image": "./assets/images/og-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "b87feb7a-4930-40d3-9e2a-95adfb577039"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
