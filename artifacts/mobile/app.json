{
  "expo": {
    "name": "OG Exports",
    "slug": "og55",
    "owner": "ogexp55",
    "version": "2.1.9",
    "orientation": "portrait",
    "icon": "./assets/images/og-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.ogexports.investor",
      "googleServicesFile": "./google-services.json",
      "versionCode": 9,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/og-logo.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "investor-updates-v2"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OG Exports uses Face ID to unlock your saved investor account and confirm protected actions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A3335",
          "image": "./assets/images/og-splash-mark.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "b87feb7a-4930-40d3-9e2a-95adfb577039"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
