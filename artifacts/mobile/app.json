{
  "expo": {
    "name": "OG Exports",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/og-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/og-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OG Exports uses Face ID to unlock your saved investor account and confirm protected actions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/og-splash.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAF8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
