modules = ["nodejs-24", "python-base-3.13", "postgresql-16", "php-8.4"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]

[userenv.shared]
OG_EXPORTS_AUTH_EMAIL_FROM = "info@ogexports.co"
EXPO_PUBLIC_API_BASE_URL = "https://api.ogexports.co/"
