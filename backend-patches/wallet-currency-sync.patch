diff --git a/app/Models/WalletCurrencyConversion.php b/app/Models/WalletCurrencyConversion.php
new file mode 100644
index 0000000..c9035b4
--- /dev/null
+++ b/app/Models/WalletCurrencyConversion.php
@@ -0,0 +1,40 @@
+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+class WalletCurrencyConversion extends Model
+{
+    protected $fillable = [
+        'wallet_id',
+        'initiated_by',
+        'from_currency',
+        'to_currency',
+        'from_amount',
+        'to_amount',
+        'exchange_rate',
+        'rates_as_of',
+    ];
+
+    protected function casts(): array
+    {
+        return [
+            'from_amount' => 'decimal:2',
+            'to_amount' => 'decimal:2',
+            'exchange_rate' => 'decimal:8',
+            'rates_as_of' => 'immutable_datetime',
+        ];
+    }
+
+    public function wallet(): BelongsTo
+    {
+        return $this->belongsTo(Wallet::class);
+    }
+
+    public function initiatedBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'initiated_by');
+    }
+}
